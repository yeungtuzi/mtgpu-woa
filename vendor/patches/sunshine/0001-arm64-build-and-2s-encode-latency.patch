+    // host-processing latency when the exact capture timestamp cannot be matched.
+    class two_second_latency_average_t {
+    public:
+      void add(std::chrono::microseconds duration) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - window_start >= std::chrono::seconds(2)) {
+          window_start = now;
+          total = std::chrono::microseconds {0};
+          count = 0;
+        }
+        total += duration;
+        ++count;
+        average = total / count;
+      }
+
+      std::optional<std::chrono::steady_clock::time_point> synthetic_timestamp() const {
+        if (count == 0) {
+          return std::nullopt;
+        }
+        return std::chrono::steady_clock::now() - average;
+      }
+
+    private:
+      std::chrono::steady_clock::time_point window_start = std::chrono::steady_clock::now();
